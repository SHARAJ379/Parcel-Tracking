GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-supported-gemini-model
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
# true on HTTPS hosting (Vercel) so the admin cookie is only sent over HTTPS
COOKIE_SECURE=false
RATE_LIMIT_REQUESTS=60
# Email import (see docs/inbound-email.md)
# At least 24 random characters; CloudMailin sends it as "Bearer <secret>"
INBOUND_EMAIL_SECRET=replace-with-a-long-random-secret
# Comma-separated addresses allowed to forward emails
ALLOWED_EMAIL_SENDERS=you@example.com
INBOUND_REQUIRE_SPF=true
INBOUND_EMAIL_RATE_LIMIT=10
